def ebenen(c):
    """Gleich nach dem Auftakt: wessen Seite das ist. «Über Eck», Abwandlung 11 «Mehrere Bilder je Seite» (Robert 26.10.2026, ebenen-wahl-3.html):
    zwei Bildgruppen zu je drei Bildern, schräg geteilt mit einer Naht in Kerzenfarbe, der Titel auf einer Tafel quer über der Naht.
    Die Texte stehen unter der Wand, nie darin (Robert 26.10.2026: «NICHT in die Bildsektion einarbeiten»): die Naht läuft unter dem Bild
    weiter und trennt sie, der Abend unter der linken Hälfte, das Haus unter der rechten, bündig mit dem Rahmen.
    Am Bildschirm rücken die Gruppen beim Hereinscrollen an der Naht zusammen (culinarium.js, data-ue).
    Texte «Am Strich entlang» mit den grossen Namen aus «Namen gross» (Robert 26.10.2026: «8 aber so wie 10 von der größe», texte-wahl.html):
    je Text ein Keil mit shape-outside, die Zeilen folgen der Schräge; Grösse des Keils setzt culinarium.js aus der Naht."""
    gruppen, texte, knoepfe_ = [], [], []
    for i, ((etikett, titel, satz, info, kn), bilder) in enumerate(zip(c['karten'], c['gruppen'])):
        fotos = ''.join(foto(k, 'ue-' + x, sizes, auf=False, pos=pos) for x, (k, pos, sizes) in zip('abc', bilder))
        gruppen.append('<div class="ue-gr ue-%s" data-ue="%d">%s</div>' % ('lr'[i], 1 - 2 * i, fotos))
        knoepfe_.append('<div class="sw auf ue-kn ue-k%s" style="--i:5">%s</div>' % ('lr'[i], knopf(*kn)))
        texte.append('<div class="ue-text ue-t%s"><i class="ue-keil" aria-hidden="true"></i>%s%s%s%s</div>' % (
            'lr'[i], sw(E(etikett), 'p', 'mono ue-etikett', 1), sw(E(titel), 'h3', 'ue-titel', 2),
            sw(E(satz), 'p', 'vtext', 3), sw('<span class="mono">%s</span>' % '&#160;· '.join(E(x).replace(' ', '&#160;') for x in info.split(' · ')), 'p', 'vinfo', 4)))
    naht = '<svg class="ue-naht" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><line x1="57" y1="0" x2="43" y2="100"/></svg>'
    weiter = '<svg class="ue-weiter" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><line x1="43" y1="0" x2="37.4" y2="100"/></svg>'
    tafel = '<div class="ue-tafel">%s</div>' % zl(c['titel'], 'h2', 'titel')
    return '<div class="h-ebenen ue"><div class="ue-rahmen">%s%s%s%s</div><div class="ue-unter">%s%s%s%s%s</div></div>' % (
        gruppen[0], gruppen[1], naht, tafel, weiter, texte[0], texte[1], knoepfe_[0], knoepfe_[1])


