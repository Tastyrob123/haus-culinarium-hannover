    z = []
    for i, p in enumerate(c['zickzack']):
        zitat = '<blockquote class="zitat"><p>%s</p><cite>%s</cite></blockquote>' % (E(p['zitat'][0]), E(p['zitat'][1])) if p.get('zitat') else ''
