# ------------------------------------------------------------------ Bausteine
def teil(x):
    return (x, '') if isinstance(x, str) else x


def verh(k):
    if k == 'film:familie':
        return 1.0
    if k == 'film:opening':
        return 9 / 16
    m = META[k]
    return m['w'] / m['h']


def film(k, cls=''):
    n = k.split(':')[1]
    return ('<figure class="film vfilm %s" style="--lq:url(assets/film/%s.webp);aspect-ratio:%s"><video muted playsinline preload="none" poster="assets/film/%s.webp?v=%s" data-src="assets/film/%s.mp4?v=%s" aria-label="%s"></video>'
            '<button class="film-nochmal" type="button" aria-label="Film noch einmal abspielen">Noch einmal</button></figure>') % (
        cls, n, '1/1' if n == 'familie' else '9/16', n, bau.VERSION, n, bau.VERSION, 'Die Mannschaft an der Theke' if n == 'familie' else 'Opening 2026 bei Dirty Chicken')


def bild(k, sizes, cls='', pos=None, natur=False):
    if k.startswith('film:'):
        return film(k, cls)
    return foto(k, cls, sizes, auf=False, pos=pos, ratio=natur)


def st(x, sizes):
    """Ein Stück in einer Reihe: natürliches Seitenverhältnis, nichts wird beschnitten."""
    k, cap = teil(x)
    return '<div class="st" style="--r:%.4f">%s%s</div>' % (verh(k), bild(k, sizes, natur=True), ('<p class="vcap">%s</p>' % cap) if cap else '')


def reihe(xs, breite=100, cls=''):
    tot = sum(verh(teil(x)[0]) for x in xs) or 1
    return '<div class="rr %s">%s</div>' % (cls, ''.join(st(x, '(max-width:860px) 50vw, %dvw' % max(14, round(breite * verh(teil(x)[0]) / tot))) for x in xs))


def zelle(x, sizes='33vw', cls=''):
    """Ein Stück in einer festen Zelle: Fotos füllen sie, Filme behalten ihr Format (die Spalte richtet sich nach dem Film)."""
    k, cap = teil(x)
    inner = bild(k, sizes)
    mf = ' mf" style="--fr:%.4f' % verh(k) if k.startswith('film:') else ''
    return '<div class="zl-z %s%s">%s%s</div>' % (cls, mf, inner, ('<p class="vcap">%s</p>' % cap) if cap else '')


def istfilm(x):
    return teil(x)[0].startswith('film:')


def platz(b, idx):
    """Den Film (falls dabei) an die Stelle setzen, deren Form zu ihm passt."""
    f = [x for x in b if istfilm(x)]
    if not f:
        return b
    rest = [x for x in b if not istfilm(x)]
    rest.insert(min(idx, len(rest)), f[0])
    return rest


def spalten(b, n, film='auto'):
    return ' style="grid-template-columns:%s"' % ' '.join(film if istfilm(x) else '1fr' for x in b[:n]) if any(istfilm(x) for x in b[:n]) else ''


def hochfilm(c):
    return any(teil(x)[0] == 'film:opening' for x in c['bilder'])


def breit(c, verhaeltnis, cls=''):
    return '<div class="vbreit %s" style="aspect-ratio:%s">%s</div>' % (cls, verhaeltnis, foto(c['gross'], '', '(max-width:860px) 100vw, 86vw', auf=False, pos=c.get('grosspos')))


def kopf(c, cls='', titel=True, text=True, rest=True):
    teile = []
    if titel:
        teile.append(zl(c['titel'], 'h2', 'titel'))
    if text:
        teile.append(sw(c['text'], 'p', 'vtext', 1))
    if rest:
        if c.get('info'):
            teile.append(sw('<span class="mono">%s</span>' % c['info'], 'p', 'vinfo', 2))
        if c.get('extra'):
            teile.append('<div class="sw auf" style="--i:3">%s</div>' % c['extra'])
        kn = ''.join(knopf(*k) for k in (c.get('knopf'), c.get('knopf2')) if k)
        if kn:
            teile.append('<div class="knoepfe sw auf" style="--i:4">%s</div>' % kn)
    return '<div class="vk %s">%s</div>' % (cls, ''.join(teile))


def bilder(c, n, ab=0):
    b = c['bilder']
    out = [b[(ab + i) % len(b)] for i in range(n)]
    return out


# ------------------------------------------------------------------ Die 15 Haltungen
def h1(c):   # Wand: Text mittig oben, darunter zwei volle Reihen Wand an Wand
    a, b = (5, 5) if c.get('dicht') else (3, 4)
    return '<div class="vi h-wand">%s<div class="vwand flaeche auf">%s%s</div></div>' % (kopf(c, 'mitte'), reihe(bilder(c, a)), reihe(bilder(c, b, a)))


def h2(c):   # Breitbild: ein breites Bild mit Text darauf, darunter eine Reihe
    unten = kopf(c, 'h2-fuss', titel=False, text=False)
    rr = list(dict.fromkeys(x for x in bilder(c, 5) if teil(x)[0] != c['gross']))[:4]
    return '<div class="vi h-breit"><div class="hb-buehne auf">%s<div class="hb-hof"></div>%s</div>%s%s</div>' % (
        breit(c, '21/9'), kopf(c, 'auf-bild', rest=False), '<div class="flaeche auf">%s</div>' % reihe(rr) if rr else '',
        unten if any(c.get(x) for x in ('info', 'extra', 'knopf')) else '')


def h3(c):   # Paar gross: zwei Bilder Wand an Wand, daneben Text und zwei kleine
    return '<div class="vi h-paar"><div class="hp-l paar auf">%s</div><div class="hp-r">%s<div class="flaeche auf">%s</div></div></div>' % (
        reihe(bilder(c, 2)), kopf(c), reihe(bilder(c, 2, 2)))


def h4(c):   # Hoch und tief: zwei Bilder auf zwei Höhen, Text mittig dazwischen
    b = platz(bilder(c, 4), 0 if hochfilm(c) else 2)
    return '<div class="vi h-hoch"><div class="hh-a paar auf">%s%s</div>%s<div class="hh-b auf">%s</div></div>' % (
        zelle(b[0], '30vw', 'hoch'), zelle(b[1], '30vw', 'tief'), kopf(c, 'mitte hh-k'), zelle(b[2], '24vw'))


def h5(c):   # Sandwich: Reihe, Text in der Mitte, Reihe
    a, b = (5, 5) if c.get('dicht') else (3, 3)
    return '<div class="vi h-sand"><div class="flaeche auf">%s</div>%s<div class="flaeche auf">%s</div></div>' % (
        reihe(bilder(c, a)), kopf(c, 'mitte quer'), reihe(bilder(c, b, a)))


def h6(c):   # Drei gleich: Text mittig, drei gleich grosse Hochformate
    n = 5 if c.get('dicht') else 3
    b = platz(bilder(c, n), 1)
    sp = spalten(b, n)
    return '<div class="vi h-drei">%s<div class="hd-r flaeche auf" %s>%s</div></div>' % (
        kopf(c, 'mitte'), sp or 'style="--n:%d"' % n, ''.join(zelle(x, '32vw') for x in b))


def h7(c):   # Band: Text als erste Karte, dann ein Band zum Wischen
    return ('<div class="vi h-band"><div class="vband" tabindex="0">%s%s</div><div class="vband-k"><button type="button" data-band="-1" aria-label="Zurück">‹</button>'
            '<button type="button" data-band="1" aria-label="Weiter">›</button></div></div>') % (
        kopf(c, 'karte'), ''.join(st(x, '(max-width:860px) 70vw, 30vw') for x in c['bilder']))


def h8(c):   # Vier im Quadrat: vier Bilder im Quadrat, daneben Text und eine Reihe
    b = platz(bilder(c, 6), 4 if hochfilm(c) else 0)
    return '<div class="vi h-vier"><div class="hv-q flaeche auf">%s</div><div class="hv-r">%s<div class="flaeche auf">%s</div></div></div>' % (
        ''.join(zelle(x, '24vw') for x in b[:4]), kopf(c), reihe(b[4:6]))


def h9(c):   # Flügel: links und rechts je zwei Bilder, Text und ein Bild in der Mitte
    b = platz(bilder(c, 5), 2)
    return '<div class="vi h-fluegel"><div class="hf-s flaeche auf">%s%s</div><div class="hf-m">%s<div class="auf">%s</div></div><div class="hf-s flaeche auf">%s%s</div></div>' % (
        zelle(b[0], '28vw'), zelle(b[1], '28vw'), kopf(c, 'mitte'), zelle(b[2], '34vw'), zelle(b[3], '28vw'), zelle(b[4], '28vw'))


def h10(c):  # Kino: breites Bild mit Titel, darunter Text und drei Bilder
    b = platz([x for x in bilder(c, 5) if teil(x)[0] != c['gross']][:3], 0)
    return '<div class="vi h-kino"><div class="hb-buehne auf">%s<div class="hb-hof"></div>%s</div><div class="hk-r">%s<div class="hk-b flaeche auf"%s>%s</div></div></div>' % (
        breit(c, '12/5'), kopf(c, 'auf-bild', text=False, rest=False), kopf(c, '', titel=False), spalten(b, 3), ''.join(zelle(x, '22vw') for x in b))


def h11(c):  # Gross und Stapel: ein grosses Bild, daneben Text und zwei Bilder
    b = platz(bilder(c, 3), 0)
    return '<div class="vi h-gross%s">' % (' mit-film' if istfilm(b[0]) else '') + '<div class="hg-l auf">%s</div><div class="hg-r">%s<div class="hg-s flaeche auf">%s%s</div></div></div>' % (
        zelle(b[0], '52vw'), kopf(c), zelle(b[1], '20vw'), zelle(b[2], '20vw'))


def h12(c):  # Treppe: vier Bilder steigen an, der Text steht über den kurzen
    b = platz(bilder(c, 4), 3 if hochfilm(c) else 1)
    return '<div class="vi h-treppe">%s<div class="ht-r flaeche auf"%s>%s</div></div>' % (
        kopf(dict(c, extra=None), 'ht-k'), spalten(b, 4), ''.join(zelle(x, '24vw', 's%d' % (i + 1)) for i, x in enumerate(b)))


def h13(c):  # Zickzack: Bilder und Text im Wechsel, zwei Zeilen
    b = bilder(c, 5)
    zweite = c.get('extra') or ('<p class="vgross mono">%s</p>' % c['info'] if c.get('info') else '')
    erste = kopf(dict(c, extra=None, info=None))
    if not zweite:
        return '<div class="vi h-zz"><div class="hz-1"><div class="paar auf">%s</div>%s</div><div class="flaeche auf">%s</div></div>' % (reihe(b[:2]), erste, reihe(b[2:5]))
    return '<div class="vi h-zz"><div class="hz-1"><div class="paar auf">%s</div>%s</div><div class="hz-2"><div class="hz-t sw auf">%s</div><div class="flaeche auf">%s</div></div></div>' % (
        reihe(b[:2]), erste, zweite, reihe(b[2:5]))


def h14(c):  # Bühne und Reihe: Text links, drei hohe Bilder rechts, darunter eine volle Reihe
    a, b = (4, 6) if c.get('dicht') else (3, 4)
    return '<div class="vi h-buehne"><div class="hbu-1">%s<div class="flaeche auf">%s</div></div><div class="flaeche auf">%s</div></div>' % (
        kopf(c), reihe(bilder(c, a), 66), reihe(bilder(c, b, a)))


def h15(c):  # Mosaik: dichte Fläche, der Text in einem eigenen Feld
    b = platz(bilder(c, 6), 2 if hochfilm(c) else 0)
    return '<div class="vi h-mosaik flaeche auf"><div class="hm-a">%s</div><div class="hm-k">%s</div>%s</div>' % (
        zelle(b[0], '48vw'), kopf(c), ''.join(zelle(x, '24vw', 'hm-%s' % z) for x, z in zip(b[1:], 'bcdef')))


HS = [None, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, h12, h13, h14, h15]


def fassung(k, n):
    c = A[k]
    inner = HS[n](c)
    ueber = '<p class="ueber sw auf">%s</p>' % c['ueber'] if c['ueber'] else ''
    return '<section class="vab v-%s h%d" data-ton="%s">%s%s</section>' % (k, n, c['ton'], inner, ueber)


# ------------------------------------------------------------------ Seite aus der Startseite
def heute(html):
    """Die heutigen Abschnitte (Fassung 0) aus index.html."""
    out = {}
    ids = ['ankommen', 'aperitif', 'gaenge', 'tafel', 'plakate', 'familie', 'dirty-chicken', 'naechster']
    for k in ids:
        i = html.index('id="%s"' % k)
        a = html.rindex('<section', 0, i)
        b = html.index('</section>', i) + len('</section>')
        out[k] = (a, b, re.sub(r'\sid="%s"' % k, '', html[a:b], count=1))
    return out


def main():
    roh = open(os.path.join(HIER, 'index.html'), encoding='utf-8').read()
    h = heute(roh)
    s = roh
    for k in reversed(REIHENFOLGE):
        a, b, alt = h[k]
        varianten = ['<div class="wv" data-n="0">%s</div>' % alt]
        for n in range(1, 16):
            varianten.append('<div class="wv" data-n="%d" hidden>%s</div>' % (n, fassung(k, n)))
        block = '<div class="wahl" id="%s" data-name="%s"><div class="wahl-marke"><b>%s</b><span data-nr>Fassung 0 · Heute</span></div>%s</div>' % (
            k, A[k]['name'], A[k]['name'], ''.join(varianten))
        s = s[:a] + block + s[b:]
    for k in FILMLQ:
        s = s.replace('--lq:url(assets/film/%s.webp)' % k, '--lq:url(%s)' % FILMLQ[k])
    s = s.replace('<title>', '<title>Auswahl · ', 1)
    s = s.replace('</head>', '<link rel="stylesheet" href="assets/wahl.css?v=%s">\n</head>' % bau.VERSION, 1)
    leiste = '''<div id="wleiste"><div class="wl-kopf"><div class="wl-ab"><b data-wl-ab></b><span data-wl-nr></span><span data-wl-name></span></div>
<div class="wl-wahl" data-wl-wahl></div><div class="wl-knoepfe"><button type="button" data-wl-zur aria-label="Vorige Fassung">‹</button><button type="button" data-wl-vor aria-label="Nächste Fassung">›</button></div></div>
<div class="wl-daumen" data-wl-daumen></div></div>
<script>window.WAHL={namen:%s,ids:%s,daumen:%s};</script>
<script src="assets/wahl.js?v=%s" defer></script>''' % (json.dumps(HALTUNGEN, ensure_ascii=False), json.dumps(REIHENFOLGE),
                                                         json.dumps(os.path.isdir(os.path.join(HIER, 'assets', 'daumen'))), bau.VERSION)
    s = s.replace('</body>', leiste + '</body>', 1)
    open(os.path.join(HIER, 'wahl.html'), 'w', encoding='utf-8').write(s)
    print('wahl.html', len(s) // 1024, 'KB')


