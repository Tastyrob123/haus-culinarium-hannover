def seitenauftakt(c):
    """Wie der gewählte Auftakt «Anstossen»: Bilder füllen die Bühne, der Titel steht gross darüber, Satz und Knopf unten links."""
    art = c.get('art', 'zwei')
    if art == 'mosaik':
        return mosaik(c)
    if art == 'ueber':
        return ueber_koepfe(c)
    if art == 'zwei':
        b = foto(c['bilder'][0], 'hoch', '(max-width:860px) 50vw, 34vw', True, False) + foto(c['bilder'][1], 'tief', '(max-width:860px) 50vw, 34vw', True, False)
    else:
        b = ''.join(foto(k, '', '(max-width:860px) 100vw, %dvw' % (100 // len(c['bilder'])), True, False) for k in c['bilder'])
    unten = sw(c['text'], 'p', 'at-satz', 2)
    if c.get('info'):
        unten += sw('<span class="mono">%s</span>' % c['info'], 'p', 'sa-info', 3)
    kn = ''.join(knopf(*k) for k in (c.get('knopf'), c.get('knopf2')) if k)
    if kn:
        unten += '<div class="knoepfe sw auf" style="--i:4">%s</div>' % kn
    hof = '<div class="sa-hof"></div>' if art in ('voll', 'mitte', 'ueber') else ''
    return '<div class="vi sa sa-%s"><div class="sa-bilder flaeche auf">%s</div>%s%s<div class="at-text">%s</div></div>' % (
        art, b, hof, zl(c['titel'], 'h2' if art == 'mitte' else 'h1', 'sa-titel'), unten)


