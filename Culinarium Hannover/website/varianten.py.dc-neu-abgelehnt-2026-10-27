def flankiert(c):
    """«Aus demselben Haus» auf der Dirty-Chicken-Seite. Fassung 6 «Flankiert» (Robert 26.10.2026, ebenen-wahl.html):
    Text als Block in der Mitte, links läuft die Tafel an den Rand, rechts die Theke; die Bilder wandern leicht gegenläufig."""
    seiten = []
    for i, (bildk, etikett, satz, info, kn) in enumerate(c['karten']):
        bild = '<div class="fl-bild fl-%s" data-fl="%d">%s<span class="fl-etikett">%s</span></div>' % (
            'lr'[i], 1 - 2 * i, foto(bildk, '', '(max-width:960px) 50vw, 32vw', auf=False), E(etikett))
        block = '<div class="fl-block">%s%s<div class="sw auf" style="--i:%d">%s</div></div>' % (
