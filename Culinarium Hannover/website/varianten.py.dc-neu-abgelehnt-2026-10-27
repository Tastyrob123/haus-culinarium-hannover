def ablauf(c):
    """So läuft ein Abend: Fotowand mit Karte nach der Machart des Grand Beau-Rivage (Robert 26.10.2026: «2» aus ablauf-wahl-seite.html,
    Bau ablauf_wahl.py). Fünf Kacheln um eine dunkle Karte mit dem Ablauf und Punktlinien, Namen in der Einkerbung, ein Bildschirm.
    Die Kacheln steigen gestaffelt von unten (Seite .foto/.da) und federn einmal; die Überschrift rollt aus dem Schlitz.
    Ohne «wand» (andere Seiten, z. B. Leute) bleibt die Reihe aus Stationen wie bisher."""
    if 'wand' not in c:
        st_ = ''.join('<article class="ab-st" style="--i:%d">%s<h3 class="ab-titel">%s</h3><p class="ab-satz">%s</p></article>' % (
            i, foto(b, '', '(max-width:860px) 46vw, 24vw', auf=False), E(t), satz) for i, (b, t, satz) in enumerate(c['stationen']))
        return '<div class="vi h-ablauf">%s<div class="ab-reihe staffel auf">%s</div></div>' % (kopf(c, 'mitte'), st_)
    kacheln = []
    for i, (k, name, platz) in enumerate(c['wand']):
        # Die Einkerbung liegt neben dem Foto im selben Rahmen, nicht im Ausschnitt des Fotos: so kann an der Kante nie eine helle Bildzeile durchscheinen (Robert 27.10.2026)
        f = foto(k, 'aw-k', '(max-width:860px) 50vw, 26vw', auf=False)
        kerbe = '<p class="aw-kerbe">%s</p>' % E(name) if name else ''
        kacheln.append('<div class="aw-z aw-%s" style="--d:%.2fs">%s%s</div>' % (platz, i * .1, f, kerbe))
    # Menükarte wie in einem Sternehaus (Robert 27.10.2026: «dunkel lassen, aber edles Sternemenü»): Doppelrahmen, Gänge mittig, Zier statt Punktlinien
    karte = ('<div class="aw-karte"><p class="aw-oben">Culinarium<i></i>Das Menü</p>%s<p class="aw-satz">%s</p><span class="aw-zier" aria-hidden="true"></span>'
             '<dl class="aw-liste">%s</dl><p class="aw-unten">%s</p></div>') % (
        zl(c['titel'], 'h2', 'titel aw-titel'), E(c['text']),
        ''.join('<div><dt>%s</dt><dd>%s</dd></div>' % (E(a), E(b)) for a, b in c['liste']), E(c.get('unten', '')))
    return '<div class="vi h-ablauf"><div class="aw auf">%s%s%s</div></div>' % (''.join(kacheln[:3]), karte, ''.join(kacheln[3:]))


