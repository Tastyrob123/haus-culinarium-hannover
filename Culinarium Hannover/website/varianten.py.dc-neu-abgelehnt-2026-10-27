def vorn_bilder(k, maske):
    """Freigestellte Leute in denselben Stufen wie das Foto k: Pixel aus dem Foto, Alpha aus der Maske (gehärtet, ohne Schleier)."""
    q = os.path.join(bau.PROJ, BILD[k][0]); mq = os.path.join(bau.PROJ, maske)
    stufen = META[k]['stufen']
    ziel = [os.path.join(HIER, 'assets/bild/%s_vorn-%d.webp' % (k, w)) for w in stufen]
    if all(os.path.exists(z) and os.path.getmtime(z) > max(os.path.getmtime(q), os.path.getmtime(mq)) for z in ziel):
        return stufen
    from PIL import Image
    im = Image.open(q).convert('RGB')
    a = Image.open(mq).convert('RGBA').getchannel('A').resize(im.size, Image.LANCZOS).point(lambda v: 0 if v < 110 else 255 if v > 200 else (v - 110) * 255 // 90)
    im = im.convert('RGBA'); im.putalpha(a)
    for w, z in zip(stufen, ziel):
        (im if im.width == w else im.resize((w, round(im.height * w / im.width)), Image.LANCZOS)).save(z, 'WEBP', quality=82, method=6)
    print('Vorn', k, stufen)
    return stufen


