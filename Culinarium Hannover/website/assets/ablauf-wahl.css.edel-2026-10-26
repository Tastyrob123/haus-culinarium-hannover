/* Wahlseite «So läuft ein Abend»: 15 edle Fassungen in der echten Startseite (nur für Robert, nicht Teil der Website).
   Haltung Luxushotel: grosse Bilder, leichte Fraunces, Haarlinien in Gold, gesperrte Etiketten, langsame Bewegung.
   Nur transform und opacity; Hereinkommendes ist von Anfang an sichtbar. */
.ae{--gold:#D9A57E;--elfenbein:#F3EDE4;--tinte:#1D1B20;--leise:rgba(250,244,244,.66);--haar:rgba(250,244,244,.16);--H:min(88vh,860px);--lang:cubic-bezier(.16,.84,.24,1);
  max-width:var(--max);margin:0 auto;padding:0 var(--rand)}
.ae .ae-b{position:relative;overflow:hidden;background:var(--schiefer)}
.ae .ae-b img{width:100%;height:100%;object-fit:cover}
.ae-lab{display:block;font:500 11px/1.4 var(--etikett);letter-spacing:.3em;text-transform:uppercase;color:var(--gold)}
.ae-t{font-family:var(--titel);font-weight:300;font-variation-settings:"SOFT" 100,"opsz" 144;line-height:1.06;letter-spacing:-.006em}
.ae-sz{color:var(--leise);font-size:16px;line-height:1.72}
.ae-strich{display:block;width:46px;height:1px;background:var(--gold);margin:20px 0}
.ae .mitte{text-align:center}.ae .mitte .ae-strich{margin-left:auto;margin-right:auto}
.ae-kopf{max-width:720px;margin:0 auto clamp(40px,6vh,72px)}
.ae-kopf.mitte{text-align:center}
.ae-h{font-size:clamp(40px,4.6vw,72px)}
.ae-kopf .ae-sz{margin-top:22px}
.ae-txt .ae-t{font-size:clamp(28px,2.8vw,42px)}
.ae-txt .ae-sz{margin-top:16px;max-width:400px}
.ae-txt.mitte .ae-sz{margin-left:auto;margin-right:auto}
.ae-pf{width:48px;height:48px;border-radius:50%;border:0;background:transparent;color:var(--weiss);box-shadow:inset 0 0 0 1px rgba(250,244,244,.36);display:grid;place-items:center;cursor:pointer;transition:box-shadow .5s}
.ae-pf:hover{box-shadow:inset 0 0 0 1px var(--gold)}
.ae-pf svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.2}
html.js:not(.ruhig) .ae .auf .ae-b img{transform:scale(1.07);transition:transform 2.4s var(--lang)}
html.js .ae .auf.da .ae-b img{transform:none}

/* 1 Doppelseite */
.ae-01{max-width:none;padding:0 var(--fuge)}
.ae-01 .ae-kopf{padding:0 var(--rand)}
.ae-dp-s{display:grid;grid-template-columns:1.12fr .88fr;gap:var(--fuge);height:var(--H);margin-bottom:var(--fuge)}
.ae-dp-s:nth-child(even){grid-template-columns:.88fr 1.12fr}
.ae-dp-s:nth-child(even) .ae-dp-g{order:2}
.ae-dp-r{display:grid;grid-template-rows:1fr 1fr;gap:var(--fuge);min-height:0}
.ae-dp-r .ae-txt{display:flex;flex-direction:column;justify-content:center;padding:0 clamp(28px,4.4vw,80px);background:#1B1A20}

/* 2 Arkaden */
.ae-ak{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:clamp(18px,2.6vw,44px)}
.ae-ak .ae-ak-b{aspect-ratio:3/4.3;border-radius:999px 999px 0 0}
.ae-ak .ae-ak-b::after{content:"";position:absolute;inset:10px;border:1px solid rgba(250,244,244,.42);border-radius:999px 999px 0 0;pointer-events:none}
.ae-ak .ae-txt{padding-top:26px}
.ae-ak .ae-txt .ae-t{font-size:clamp(22px,2vw,30px)}
.ae-ak .ae-strich{margin:14px auto}
.ae-ak .ae-txt .ae-sz{font-size:14.5px;margin-top:0}
.ae-ak-st:nth-child(2) img{transition-delay:.15s!important}.ae-ak-st:nth-child(3) img{transition-delay:.3s!important}.ae-ak-st:nth-child(4) img{transition-delay:.45s!important}

/* 3 Vier Paneele */
.ae-03{max-width:none;padding:0}
.ae-pn{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:2px;height:var(--H)}
.ae-pn-p{position:relative;overflow:hidden}
.ae-pn-p>.ae-b{position:absolute;inset:0}
.ae-pn-p::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(15,14,19,.4),rgba(15,14,19,0) 24%,rgba(15,14,19,0) 46%,rgba(15,14,19,.9));pointer-events:none}
.ae-pn-dim{position:absolute;inset:0;z-index:1;background:var(--nacht-tief);opacity:0;transition:opacity 1s var(--k)}
.ae-pn:hover .ae-pn-p:not(:hover) .ae-pn-dim{opacity:.58}
.ae-pn-o{position:absolute;left:clamp(20px,2.4vw,36px);top:clamp(22px,3vh,34px);z-index:2}
.ae-pn-u{position:absolute;left:clamp(20px,2.4vw,36px);right:clamp(20px,2.4vw,36px);bottom:clamp(26px,4vh,44px);z-index:2}
.ae-pn-u .ae-t{font-size:clamp(26px,2.6vw,40px)}
.ae-pn-l{display:block;height:1px;background:var(--gold);margin:18px 0 16px;transform:scaleX(.16);transform-origin:0 50%;transition:transform 1.2s var(--lang)}
.ae-pn-p:hover .ae-pn-l{transform:none}
.ae-pn-u .ae-sz{font-size:14.5px;line-height:1.6;opacity:0;transition:opacity .9s var(--k)}
.ae-pn-p:hover .ae-sz{opacity:1}

/* 4 Die Einladung */
.ae-04{max-width:none;padding:0}
.ae-ei{position:relative;padding-bottom:4vh}
.ae-ei .ae-ei-b{height:min(76vh,760px)}
.ae-ei-k{position:relative;width:min(1180px,calc(100% - 2*var(--rand)));margin:max(-30vh,-300px) auto 0;background:var(--elfenbein);color:var(--tinte);padding:clamp(28px,4vw,60px) clamp(24px,4vw,64px);box-shadow:0 40px 80px -30px rgba(0,0,0,.75);transition:transform 1.8s var(--lang)}
html.js:not(.ruhig) .ae-ei:not(.da) .ae-ei-k{transform:translateY(26px)}
.ae-ei-kopf{display:flex;align-items:center;gap:20px}
.ae-ei-kopf::before,.ae-ei-kopf::after{content:"";flex:1;height:1px;background:#CDBFAE}
.ae-ei-kopf .ae-lab{color:#9C6847}
.ae-ei-h{text-align:center;color:var(--tinte);margin:18px 0 clamp(26px,3.6vw,44px)}
.ae-ei-r{display:grid;grid-template-columns:repeat(4,minmax(0,1fr))}
.ae-ei-r>div{padding:0 clamp(14px,2vw,30px);border-left:1px solid #D9CEC1}
.ae-ei-r>div:first-child{border-left:0;padding-left:0}
.ae-ei-r>div:last-child{padding-right:0}
.ae-ei-r .ae-t{font-size:clamp(21px,2vw,30px);color:var(--tinte)}
.ae-ei-r p{font-size:14.5px;line-height:1.65;color:#5D5761;margin-top:10px}

/* 5 Galerie */
.ae-05{max-width:none;padding:0}
.ae-05 .ae-kopf{padding:0 var(--rand)}
.ae-ga{position:relative;height:var(--H);overflow:hidden}
.ae-ga-bild img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transform:scale(1.06);transition:opacity 1.6s var(--k),transform 9s linear}
.ae-ga-bild img.an{opacity:1;transform:none}
.ae-ga-t{position:absolute;left:0;bottom:0;width:min(520px,52%);height:clamp(250px,34vh,320px);background:var(--nacht)}
.ae-ga-t>div{position:absolute;inset:0;padding:clamp(28px,3.4vw,52px);opacity:0;transition:opacity .4s}
.ae-ga-t>div.an{opacity:1;transition:opacity 1s .4s var(--k)}
.ae-ga-st{position:absolute;right:clamp(20px,3vw,48px);bottom:clamp(20px,3.4vw,44px);display:flex;align-items:center;gap:14px;z-index:2}
.ae-ga-lauf{width:120px;height:1px;background:rgba(250,244,244,.32);overflow:hidden;margin-right:10px}
.ae-ga-lauf i{display:block;height:100%;background:var(--weiss);transform:scaleX(0);transform-origin:0 50%}

/* 6 Triptychon */
.ae-06{max-width:none;padding:0;overflow:hidden}
.ae-06 .ae-kopf{padding:0 var(--rand)}
.ae-tp{position:relative}
.ae-tp-spur{display:flex;gap:3.4vw;transition:transform 1.4s var(--lang);will-change:transform}
.ae-tp-st{flex:0 0 min(32vw,calc(var(--H)*.5));transform:scale(.8);opacity:.4;transition:transform 1.4s var(--lang),opacity 1.4s var(--lang)}
.ae-tp-st.an{transform:none;opacity:1}
.ae-tp-st .ae-b{aspect-ratio:3/4}
.ae-tp-st .ae-txt{padding-top:24px;opacity:0;transition:opacity .9s var(--k)}
.ae-tp-st.an .ae-txt{opacity:1}
.ae-tp-st .ae-strich{margin:14px auto}
.ae-tp-st .ae-sz{margin-top:0!important}
.ae-tp-z,.ae-tp-v{position:absolute;top:calc(min(32vw,var(--H)*.5)*.66);z-index:2;background:var(--nacht)}
.ae-tp-z{left:var(--rand)}.ae-tp-v{right:var(--rand)}

/* 7 Übereinander */
.ae-07{max-width:none;padding:0}
.ae-07 .ae-kopf{padding:0 var(--rand)}
.ae-ub-p{position:sticky;top:0;height:100vh;height:100svh;overflow:hidden}
.ae-ub-p>.ae-b{position:absolute;inset:0}
.ae-ub-p::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(15,14,19,0) 42%,rgba(15,14,19,.86));pointer-events:none}
.ae-ub-t{position:absolute;left:50%;bottom:10vh;transform:translateX(-50%);width:min(620px,88%);z-index:2}
.ae-ub-t .ae-t{font-size:clamp(42px,5vw,80px)}
.ae-ub-t .ae-sz{color:rgba(250,244,244,.84)}

/* 8 Medaillons */
.ae-md{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:clamp(22px,3.6vw,64px);padding:0 clamp(0px,2vw,40px)}
.ae-md .ae-md-o{aspect-ratio:3/4;border-radius:50%;overflow:hidden;box-shadow:0 0 0 1px rgba(217,165,126,.75),0 0 0 9px var(--nacht),0 0 0 10px rgba(250,244,244,.22)}
.ae-md .ae-txt{padding-top:30px}
.ae-md .ae-txt .ae-t{font-size:clamp(22px,2vw,30px)}
.ae-md .ae-strich{margin:14px auto}
.ae-md .ae-txt .ae-sz{font-size:14.5px;margin-top:0}

/* 9 Die Liste */
.ae-09{max-width:none;padding:0}
.ae-ls{display:grid;grid-template-columns:1.1fr .9fr;gap:var(--fuge);min-height:var(--H)}
.ae-ls-l{display:flex;flex-direction:column;justify-content:center;padding:clamp(40px,6vh,80px) clamp(24px,5vw,96px)}
.ae-ls-l .ae-h{margin-bottom:clamp(28px,4vh,48px)}
.ae-ls-z button{display:grid;grid-template-columns:clamp(130px,13vw,190px) 1fr;align-items:baseline;width:100%;padding:clamp(12px,1.8vh,20px) 0;border:0;border-top:1px solid var(--haar);background:none;color:inherit;text-align:left;cursor:pointer}
.ae-ls-z button:last-child{border-bottom:1px solid var(--haar)}
.ae-ls-z .ae-t{font-size:clamp(30px,3.6vw,56px);color:rgba(250,244,244,.32);transition:color .7s,transform 1.1s var(--lang)}
.ae-ls-z .ae-lab{color:rgba(217,165,126,.5);transition:color .7s}
.ae-ls-z button.an .ae-t{color:var(--weiss);transform:translateX(16px)}
.ae-ls-z button.an .ae-lab{color:var(--gold)}
.ae-ls-s{margin-top:26px;min-height:3.6em;max-width:480px}
.ae-ls-bild{position:relative;overflow:hidden;background:var(--schiefer)}
.ae-ls-bild img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity 1.1s var(--k)}
.ae-ls-bild img.an{opacity:1}

/* 10 Bild und Detail */
.ae-bd-z{position:relative;height:var(--H);margin-bottom:clamp(30px,6vh,80px)}
.ae-bd-g{position:absolute!important;left:0;top:4%;width:56%;height:84%}
.ae-bd-k{position:absolute!important;left:47%;top:46%;width:22%;height:46%;box-shadow:0 0 0 8px var(--nacht);will-change:transform}
.ae-bd-z>.ae-txt{position:absolute;left:73%;top:50%;transform:translateY(-50%);width:27%}
.ae-bd-z:nth-child(even) .ae-bd-g{left:auto;right:0}
.ae-bd-z:nth-child(even) .ae-bd-k{left:auto;right:47%}
.ae-bd-z:nth-child(even)>.ae-txt{left:0}

/* 11 Promenade */
.ae-11{max-width:none;padding:0}
.ae-pr-w{position:relative}
.ae-pr{display:flex;gap:clamp(20px,2.6vw,40px);overflow-x:auto;scroll-snap-type:x proximity;scroll-padding-inline:var(--rand);scrollbar-width:none;padding:0 var(--rand) 2px max(var(--rand),calc((100vw - var(--max))/2 + var(--rand)))}
.ae-pr::-webkit-scrollbar{display:none}
.ae-pr-i{scroll-snap-align:start;flex:0 0 clamp(260px,26vw,380px);display:flex;flex-direction:column;justify-content:flex-end;padding-bottom:clamp(110px,15vh,150px)}
.ae-pr-i .ae-h{font-size:clamp(38px,4vw,60px)}
.ae-pr-k{flex:0 0 auto;width:min(38vw,calc(var(--H)*.56));scroll-snap-align:start}
.ae-pr-k .ae-b{aspect-ratio:3/4}
.ae-pr-k .ae-txt{padding-top:24px}
.ae-pr-k .ae-txt .ae-t{font-size:clamp(24px,2.2vw,34px)}
.ae-pr-k .ae-strich{margin:14px 0}
.ae-pr-k .ae-txt .ae-sz{margin-top:0;font-size:15px}
.ae-pr-f{max-width:calc(var(--max) - 2*var(--rand));margin:clamp(30px,4vh,48px) auto 0;height:1px;background:rgba(250,244,244,.18)}
.ae-pr-f i{display:block;height:100%;background:var(--gold);transform-origin:0 50%;transform:scaleX(.2)}
.ae-pr-st{display:flex;gap:12px;justify-content:flex-end;max-width:calc(var(--max) - 2*var(--rand));margin:22px auto 0}

/* 12 Passepartout */
.ae-pp{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:clamp(22px,3.6vw,60px);padding:clamp(40px,6vh,70px) clamp(22px,4vw,64px);background:radial-gradient(ellipse at 50% 0%,#2C2932,#17161B 72%);border-radius:2px}
.ae-pp-r{background:var(--elfenbein);padding:9%;box-shadow:0 0 0 3px #0D0C10,0 0 0 4px rgba(217,165,126,.55),0 28px 44px rgba(0,0,0,.55)}
.ae-pp-r .ae-b{aspect-ratio:3/4}
.ae-pp .ae-txt{padding-top:30px}
.ae-pp .ae-txt .ae-t{font-size:clamp(20px,1.8vw,27px)}
.ae-pp .ae-strich{margin:14px auto}
.ae-pp .ae-txt .ae-sz{font-size:14px;margin-top:0}

/* 13 Geteilt */
.ae-gt{display:grid;grid-template-columns:1fr 1fr;gap:clamp(24px,4vw,72px)}
.ae-gt-l{position:relative}
.ae-gt-st{position:sticky;top:0;height:100vh;height:100svh}
.ae-gt-st>div{position:absolute;inset:0;display:flex;align-items:center;opacity:0;transition:opacity .3s}
.ae-gt-st>div.an{opacity:1;transition:opacity 1s .2s var(--k)}
.ae-gt-st .ae-t{font-size:clamp(44px,5vw,80px)}
.ae-gt-r{display:flex;flex-direction:column;gap:var(--fuge);padding:6vh 0}
.ae-gt-g{display:flex;flex-direction:column;gap:var(--fuge);margin-bottom:12vh}
.ae-gt-g .ae-b{aspect-ratio:4/5}
.ae-gt-g .ae-b.schmal{width:66%;margin-left:auto;aspect-ratio:4/5}

/* 14 Register */
.ae-rg-r{position:relative;display:flex;justify-content:space-between;gap:24px;border-bottom:1px solid var(--haar)}
.ae-rg-r button{border:0;background:none;color:inherit;padding:8px 0 20px;cursor:pointer}
.ae-rg-r .ae-t{font-size:clamp(20px,2.2vw,32px);color:rgba(250,244,244,.4);transition:color .6s}
.ae-rg-r button.an .ae-t,.ae-rg-r button:hover .ae-t{color:var(--weiss)}
.ae-rg-s{position:absolute;left:0;bottom:-1px;width:100px;height:1px;background:var(--gold);transform-origin:0 50%;transition:transform 1.1s var(--lang)}
.ae-rg-k{display:grid;grid-template-columns:1.45fr 1fr;gap:var(--fuge);height:min(76vh,740px);margin-top:var(--fuge)}
.ae-rg-b,.ae-rg-d{position:relative;overflow:hidden;background:var(--schiefer)}
.ae-rg-b img,.ae-rg-d img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity 1.1s var(--k)}
.ae-rg-b img.an,.ae-rg-d img.an{opacity:1}
.ae-rg-re{display:grid;grid-template-rows:auto 1fr;gap:var(--fuge);min-height:0}
.ae-rg-t{position:relative;min-height:clamp(250px,32vh,300px)}
.ae-rg-t>div{position:absolute;inset:0;padding:clamp(26px,3.4vw,52px) clamp(24px,3vw,48px);opacity:0;transition:opacity .35s}
.ae-rg-t>div.an{opacity:1;transition:opacity 1s .3s var(--k)}

/* 15 Die Kolumne */
.ae-15{max-width:none;padding:0}
.ae-ko-kopf{max-width:680px;margin:0 auto;padding:0 24px;text-align:center}
.ae-ko-kopf .ae-strich{margin-left:auto;margin-right:auto}
.ae-ko-ini{text-align:left;margin-top:26px}
.ae-ko-ini::first-letter{float:left;font:300 74px/.84 var(--titel);font-variation-settings:"SOFT" 100;color:var(--gold);margin:8px 12px 0 0}
.ae .ae-ko-b{height:min(78vh,780px);margin:clamp(48px,8vh,96px) var(--fuge) 0}
.ae-ko-paar{display:grid;grid-template-columns:1fr 1fr;gap:var(--fuge);height:min(78vh,780px);margin:clamp(48px,8vh,96px) var(--fuge) 0}
.ae-ko-t{max-width:560px;margin:clamp(30px,5vh,52px) auto 0;padding:0 24px}

/* Handy */
@media (max-width:860px){
  .ae{--H:min(80svh,700px)}
  .ae-dp-s,.ae-dp-s:nth-child(even){grid-template-columns:1fr;grid-template-rows:56% 44%;height:auto;min-height:var(--H)}
  .ae-dp-s:nth-child(even) .ae-dp-g{order:0}
  .ae-dp-r{grid-template-rows:auto}.ae-dp-r>.ae-b{display:none}
  .ae-dp-r .ae-txt{padding:30px 22px}
  .ae-ak,.ae-md,.ae-pp{grid-template-columns:1fr 1fr;gap:28px 16px;padding-left:0;padding-right:0}
  .ae-pp{padding:28px 18px}
  .ae-ak .ae-txt .ae-sz,.ae-md .ae-txt .ae-sz,.ae-pp .ae-txt .ae-sz{display:none}
  .ae-pn{grid-template-columns:1fr 1fr;grid-template-rows:1fr 1fr}
  .ae-pn-u .ae-sz{display:none}.ae-pn-l{transform:none}
  .ae-ei .ae-ei-b{height:52vh}
  .ae-ei-k{margin-top:-18vh}
  .ae-ei-r{grid-template-columns:1fr;gap:20px}
  .ae-ei-r>div{border-left:0;padding:0 0 20px;border-bottom:1px solid #D9CEC1}
  .ae-ei-r>div:last-child{border-bottom:0;padding-bottom:0}
  .ae-ga-t{width:100%;height:auto;min-height:230px}
  .ae-ga-st{top:18px;bottom:auto}
  .ae-tp-st{flex-basis:66vw}
  .ae-tp-z,.ae-tp-v{top:44vw}
  .ae-ls{grid-template-columns:1fr}
  .ae-ls-bild{order:-1;height:52svh}
  .ae-ls-z button{grid-template-columns:1fr}.ae-ls-z .ae-lab{display:none}
  .ae-bd-z{height:auto;padding-bottom:20px}
  .ae-bd-g{position:relative!important;left:0!important;right:auto!important;top:0;width:82%;height:52svh}
  .ae-bd-k{left:auto!important;right:0!important;top:30svh;width:42%;height:26svh}
  .ae-bd-z>.ae-txt{position:static;transform:none;width:auto;margin-top:28px}
  .ae-pr-k{width:76vw}
  .ae-pr-i{flex-basis:78vw;padding-bottom:40px}
  .ae-gt{grid-template-columns:1fr 1fr;gap:16px}
  .ae-gt-st .ae-t{font-size:30px}.ae-gt-st .ae-sz{font-size:14px}
  .ae-rg-r{overflow-x:auto;justify-content:flex-start;scrollbar-width:none}
  .ae-rg-r button{flex:0 0 auto}
  .ae-rg-k{grid-template-columns:1fr;height:auto}
  .ae-rg-b{height:50svh}.ae-rg-d{display:none}
}
