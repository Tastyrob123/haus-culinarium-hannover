    addEventListener('resize', setz); beimZeigen.push(setz); setz();
  });

  /* 9 Die Liste: Zeigen rückt den Titel ein und blendet das Bild über */
  $$('[data-ae-liste]').forEach(function (l) {
    var z = $$('.ae-ls-z button', l), imgs = $$('.ae-ls-bild img', l), satz = l.querySelector('.ae-ls-s');
    var texte = ['Zum Ankommen gibt es einen Aperitif. Die Tafel ist gedeckt, die Kerzen brennen.', 'Aus der Küche kommen drei Gänge, Teller für Teller für die ganze Tafel. Das Menü wechselt mit jedem Abend.', 'Zu den Gängen kommen fünf Signature Drinks von Momo, gemacht für genau dieses Essen.', 'Momo erklärt jeden Drink am Tisch, damit man die Aromen nicht nur schmeckt, sondern auch versteht.'];
    z.forEach(function (b) { function setz() { var i = +b.dataset.i; setzeAn(z, i); setzeAn(imgs, i); satz.textContent = texte[i]; } b.addEventListener('mouseenter', setz); b.addEventListener('click', setz); });
  });

  /* 14 Register: Goldlinie gleitet zum gewählten Reiter */
  $$('[data-ae-reg]').forEach(function (r) {
    var bt = $$('.ae-rg-r button', r), s = r.querySelector('.ae-rg-s'), bild = $$('.ae-rg-b img', r), det = $$('.ae-rg-d img', r), tx = $$('.ae-rg-t>div', r), i = 0;
    function setz(n) { i = n; setzeAn(bt, i); setzeAn(bild, i); setzeAn(det, i); setzeAn(tx, i); if (!sichtbar(r)) return; var b = bt[i]; s.style.transform = 'translateX(' + b.offsetLeft + 'px) scaleX(' + (b.offsetWidth / 100).toFixed(3) + ')'; }
