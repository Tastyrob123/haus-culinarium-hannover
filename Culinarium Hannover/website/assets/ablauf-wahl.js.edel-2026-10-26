  });

  /* 6 Triptychon: die Reihe rückt, die Mitte wächst */
  $$('[data-ae-trip]').forEach(function (t) {
    var spur = t.querySelector('.ae-tp-spur'), st = $$('.ae-tp-st', t), i = 1;
    function setz() { if (!sichtbar(t)) return; var a = st[i]; spur.style.transform = 'translateX(' + (t.clientWidth / 2 - (a.offsetLeft + a.offsetWidth / 2)).toFixed(1) + 'px)'; setzeAn(st, i); }
