{
  "functions": { "api/entwurf.py": { "maxDuration": 60, "includeFiles": "api/_daten/**" } },
  "headers": [
    { "source": "/(.*)", "headers": [ { "key": "X-Robots-Tag", "value": "noindex, nofollow" } ] },
    { "source": "/haeuser/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=86400" } ] }
  ]
}
