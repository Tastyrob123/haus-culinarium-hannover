51", "n": 0, "tag": "a", "t": "English", "zu": "", "vor": "Startseite", "ober": "", "gleich": 2}], "fotos": []}, {"h": "b65e6e1f8b", "n": 0, "titel": "Das Team.", "tag": "section", "fest": false, "zu": "", "aus": false, "stellen": [{"h": "c5c862f8bc", "n": 0, "tag": "span", "t": "Das Team.", "zu": "", "vor": "", "ober": "", "gleich": 1}, {"h": "a94d664f88", "n": 0, "tag": "p", "t": "Die Menschen hinter Culinarium und dem Walk on the Wild Side.", "zu": "", "vor": "Das Team.", "ober": "", "gleich": 1}], "fotos": [{"b": "team_alle", "n": 0, "alt": "Das ganze Team hinter der Theke", "zu": "", "klein": "assets/bild/team_alle-640.webp?v=26218", "neu": false}]}, {"h": "0ecb77d393", "n": 0, "titel": "Drei Leute, ein Haus.", "tag": "section", "fest": false, "zu": "", "aus": false, "stellen": [{"h": "c9776d8aff", "n": 0, "tag": "span", "t": "Drei Leute,", "zu": "", "vor": "", "ober": "", "gleich": 1}, {"h": "01643afe1b", "n": 0, "tag": "span", "t": "ein Haus.", "zu": "", "vor": "Drei Leute,", "ober": "", "gleich": 1}, {"h": "5c82faa0f5", "n": 0, "tag": "p", "t": "Wer an einem Abend hinter der Theke, in der Küche und an der Tafel steht.", "zu": "", "vor": "ein Haus.", "ober": "", "gleich": 1}, {"h": "5e338e06ba", "n": 0, "tag": "p", "t": "Führt die Bar", "zu": "", "vor": "Wer an einem Abend hinter der Theke, in der Küche und an der Tafel ste", "ober": "", "gleich": 1}, {"h": "cc3692191c", "n": 0, "tag": "h3", "t": "Derya Ivkin", "zu": "", "vor": "Führt die Bar", "ober": "", "gleich": 1}, {"h": "8f94c41f43", "n": 0, "tag": "p", "t": "Führt das Walk on the Wild Side, das Haus von Culinarium, seit dem Reopening im November 2023. Eine Karte gibt es bei ihr nicht: Wer an die Theke kommt, bekommt einen Drink nach seinem Geschmack.", "zu": "", "vor": "Derya Ivkin", "ober": "", "gleich": 1}, {"h": "0a3fbb7f3e", "n": 0, "tag": "p", "t": "„Ich bin die Karte.“", "zu": "", "vor": "Derya Ivkin", "ober": "", "gleich": 1}, {"h": "d8c9d81a9b", "n": 0, "tag": "cite", "t": "Derya in der Neuen Presse, Januar 2024", "zu": "", "vor": "„Ich bin die Karte.“", "ober": "Derya Ivkin", "gleich": 1}, {"h": "43daf6b155", "n": 0, "tag": "dt", "t": "Herkunft", "zu": "", "vor": "Derya in der Neuen Presse, Januar 2024", "ober": "Derya Ivkin", "gleich": 1}, {"h": "0010570c37", "n": 0, "tag": "dd", "t": "Zu Hause in Hannover, mit Wurzeln in Ordu an der türkischen Schwarzmeerküste.", "zu": "", "vor": "Herkunft", "ober": "", "gleich": 1}, {"h": "5eefbb373f", "n": 0, "tag": "dt", "t": "2023", "zu": "", "vor": "Zu Hause in Hannover, mit Wurzeln in Ordu an der türkischen Schwarzmee", "ober": "Herkunft", "gleich": 2}, {"h": "75b21e5ad7", "n": 0, "tag": "dd", "t": "Sie übernimmt die Bar in Linden und macht sie im November neu auf, ohne Getränkekarte: Man sagt, was man mag, und bekommt seinen eigenen Drink. Zu den Drinks kam sie über Momo.", "zu": "", "vor": "2023", "ober": "", "gleich": 1}, {"h": "20c7b41ff9", "n": 0, "tag": "dt", "t": "Das Haus", "zu": "", "vor": "2023", "ober": "", "gleich": 1}, {"h": "063d8f1fec", "n": 0, "tag": "dd", "t": "Unter ihr wird die Bar zum Haus für mehr: Culinarium an der langen Tafel, Bartender aus anderen Bars als Gäste hinter der Theke, Konzerte am Donnerstag.", "zu": "", "vor": "Das Haus", "ober": "", "gleich": 1}, {"h": "bfdfd5bd07", "n": 0, "tag": "dt", "t": "Samstags", "zu": "", "vor": "Das Haus", "ober": "", "gleich": 1}, {"h": "2ce8786411", "n": 0, "tag": "dd", "t": "An manchen Samstagen legen DJs auf, dann gibt es Drinks und Musik bis 2 Uhr.", "zu": "", "vor": "Samstags", "ober": "", "gleich": 1}, {"h": "2a94fd67ca", "n": 0, "tag": "a", "t": "@derrisch__", "zu": "", "vor": "Samstags", "ober": "", "gleich": 1}, {"h": "7aa94365ab", "n": 0, "tag": "p", "t": "Mixt die Drinks", "zu": "", "vor": "@derrisch__", "ober": "Samstags", "gleich": 1}, {"h": "33a38d60d5", "n": 0, "tag": "h3", "t": "Momo", "zu": "", "vor": "Mixt die Drinks", "ober": "Samstags", "gleich": 1}, {"h": "46bdb5a084", "n": 0, "tag": "p", "t": "Mohamed Ben Khelifa", "zu": "", "vor": "Momo", "ober": "", "gleich": 1}, {"h": "9043521437", "n": 0, "tag": "p", "t": "Steht hinter der Bar und mixt die Signature Drinks, auch die fünf eines Culinarium-Abends, und erklärt jeden selbst.", "zu": "", "vor": "Mohamed Ben Khelifa", "ober": "Momo", "gleich": 1}, {"h": "6651a4246a", "n": 0, "tag": "p", "t": "„Du sagst mir, was du magst, ich mache dir einen Drink.“", "zu": "", "vor": "Mohamed Ben Khelifa", "ober": "Momo", "gleich": 1}, {"h": "c8b710074e", "n": 0, "tag": "cite", "t": "Momos Motto an der Theke", "zu": "", "vor": "„Du sagst mir, was du magst, ich mache dir einen Drink.“", "ober": "Momo", "gleich": 1}, {"h": "846f2ba09f", "n": 0, "tag": "dt", "t": "2018", "zu": "", "vor": "Momos Motto an der Theke", "ober": "Momo", "gleich": 1}, {"h": "a694fd8b7e", "n": 0, "tag": "dd", "t": "Barchef im Lindenblatt in Hannover. Schon damals mixt er eigene Drinks, etwa mit Melone, rosa Pfeffer und Honig.", "zu": "", "vor": "2018", "ober": "", "gleich": 1}, {"h": "5eefbb373f", "n": 1, "tag": "dt", "t": "2023", "zu": "", "vor": "2018", "ober": "", "gleich": 2}, {"h": "5a75e9641b", "n": 0, "tag": "dd", "t": "Im Mai macht er das erste Pop-up im Walk on the Wild Side, im September folgen die ersten Abende mit Menü und seinen Drinks. So beginnt Culinarium.", "zu": "", "vor": "2023", "ober": "", "gleich": 1}, {"h": "2bc16dbc84", "n": 0, "tag": "dt", "t": "Im Glas", "zu": "", "vor": "2023", "ober": "", "gleich": 1}, {"h": "5c6d10c0fe", "n": 0, "tag": "dd", "t": "Er arbeitet mit Techniken aus der Mixology: Milch macht einen Drink klar und weich, Fett gibt der Spirituose seinen Geschmack mit.", "zu": "", "vor": "Im Glas", "ober": "", "gleich": 1}, {"h": "a9c6d3523a", "n": 0, "tag": "dt", "t": "Unterwegs", "zu": "", "vor": "Im Glas", "ober": "", "gleich": 1}, {"h": "14750f9313", "n": 0, "tag": "dd", "t": "Auch außerhalb der Bar steht er hinter der Theke, in den Sommern 2024 und 2025 etwa beim Maschseefest am See.", "zu": "", "vor": "Unterwegs", "ober": "", "gleich": 1}, {"h": "3d775b6d23", "n": 0, "tag": "a", "t": "@momo012027", "zu": "", "vor": "Unterwegs", "ober": "", "gleich": 1}, {"h": "6d6229b49a", "n": 0, "tag": "p", "t": "Kocht die Gänge", "zu": "", "vor": "@momo012027", "ober": "Unterwegs", "gleich": 1}, {"h": "44e9bb1e5f", "n": 0, "tag": "h3", "t": "Rudi Napieraj", "zu": "", "vor": "Kocht die Gänge", "ober": "Unterwegs", "gleich": 1}, {"h": "af899612c9", "n": 0, "tag": "p", "t": "Rudolf Napieraj", "zu": "", "vor": "Rudi Napieraj", "ober": "", "gleich": 1}, {"h": "5484370405", "n": 0, "tag": "p", "t": "Kocht seit 2024 bei Culinarium, drei Gänge an der langen Tafel, und steht beim Pop-up Dirty Chicken in der Küche.", "zu": "", "vor": "Rudolf Napieraj", "ober": "Rudi Napieraj", "gleich": 1}, {"h": "6d74ecfb96", "n": 0, "tag": "p", "t": "„Unser Herzensprojekt.“", "zu": "", "vor": "Rudolf Napieraj", "ober": "Rudi Napieraj", "gleich": 1}, {"h": "063adb73c7", "n": 0, "tag": "cite", "t": "Rudi über Culinarium, Juli 2024", "zu": "", "vor": "„Unser Herzensprojekt.“", "ober": "Rudi Napieraj", "gleich": 1}, {"h": "73f7fc916c", "n": 0, "tag": "dt", "t": "2024", "zu": "", "vor": "Rudi über Culinarium, Juli 2024", "ober": "Rudi Napieraj", "gleich": 1}, {"h": "830a0cc5b7", "n": 0, "tag": "dd", "t": "Im April kocht er seinen ersten Culinarium-Abend. Seitdem stehen auf jedem Plakat zwei Namen: Momo für die Drinks, Rudi für die Küche.", "zu": "", "vor": "2024", "ober": "", "gleich": 1}, {"h": "a1a2a68de9", "n": 0, "tag": "dt", "t": "Am Teller", "zu": "", "vor": "2024", "ober": "", "gleich": 1}, {"h": "bb2a0f849d", "n": 0, "tag": "dd", "t": "Gemüse steht bei ihm oft im Mittelpunkt: Lauch, Blumenkohl, Kürbis, Rote Bete. Zu jedem Gang gibt es einen passenden Drink von Momo.", "zu": "", "vor": "Am Teller", "ober": "", "gleich": 1}, {"h": "29e56b1bdb", "n": 0, "tag": "dt", "t": "2025", "zu": "", "vor": "Am Teller", "ober": "", "gleich": 1}, {"h": "2644e3bc7c", "n": 0, "tag": "dd", "t": "Im Juli kocht er für die erste Tacos & Tequila Party in der Bar, zusammen mit Momo.", "zu": "", "vor": "2025", "ober": "", "gleich": 1}, {"h": "2514afd19e", "n": 0, "tag": "dt", "t": "2026", "zu": "", "vor": "Im Juli kocht er für die erste Tacos & Tequila Party in der Bar, zusam", "ober": "2025", "gleich": 1}, {"h": "3ea30dd49c", "n": 0, "tag": "dd", "t": "Zum Valentinstag ein eigenes Menü in der Bar. Dazu startet er Dirty Chicken, ein Pop-up mit Chicken-Sandwiches, Pommes und Drinks.", "zu": "", "vor": "2026", "ober": "", "gleich": 1}, {"h": "abdafc7a2b", "n": 0, "tag": "a", "t": "@rudi__san", "zu": "", "vor": "2026", "ober": "", "gleich": 1}], "fotos": [{"b": "w3", "n": 0, "alt": "In der Bar", "zu": "", "klein": "assets/bild/w3-640.webp?v=26218", "neu": false}, {"b": "ecke", "n": 0, "alt": "Die Hausecke mit der Bar", "zu": "", "klein": "assets/bild/ecke-640.webp?v=26218", "neu": false}, {"b": "barlicht", "n": 0, "alt": "Die Bar bei Nacht von draußen", "zu": "", "klein": "assets/bild/barlicht-640.webp?v=26218", "neu": false}, {"b": "momo_hoch", "n": 0, "alt": "Momo vor der Bar", "zu": "", "klein": "assets/bild/momo_hoch-640.webp?v=26218", "neu": false}, {"b": "schaum", "n": 0, "alt": "Schaum aus dem Siphon auf einem Drink", "zu": "", "klein": "assets/bild/schaum-640.webp?v=26218", "neu": false}, {"b": "d3", "n": 0, "alt": "Ein Drink wird durch das Sieb gegossen", "zu": "", "klein": "assets/bild/d3-640.webp?v=26218", "neu": false}, {"b": "w4", "n": 0, "alt": "Am Durchgang", "zu": "", "klein": "assets/bild/w4-640.webp?v=26218", "neu": false}, {"b": "beete", "n": 0, "alt": "Rote Bete mit Schaum", "zu": "", "klein": "assets/bild/beete-640.webp?v=26218", "neu": false}, {"b": "pass3", "n": 0, "alt": "Eine Reihe Teller wird garniert", "zu": "", "klein": "assets/bild/pass3-640.webp?v=26218", "neu": false}]}, {"h": "71977fbfea", "n": 0, "titel": "Bei der Arbeit.", "tag": "section", "fest": false, "zu": "", "aus": false, "stellen": [{"h": "fb66545757", "n": 0, "tag": "span", "t": "Bei der Arbeit.", "zu": "", "vor": "", "ober": "", "glei