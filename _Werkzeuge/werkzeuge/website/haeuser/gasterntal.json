      {
       "key": "name",
       "label": "Name",
       "art": "text",
       "wo": "h2",
       "titel": true
      },
      {
       "key": "satz",
       "label": "Zeile darunter",
       "art": "text",
       "wo": "p.lead"
      },
      {
       "key": "bild",
       "label": "Foto",
       "art": "bild",
       "wo": "img"
      }
     ]
    }
   ]
  },
  "preisstufen": {
   "name": "Zimmerpreise",
   "satz": "Jede Preiszeile der Zimmer-Seite.",
