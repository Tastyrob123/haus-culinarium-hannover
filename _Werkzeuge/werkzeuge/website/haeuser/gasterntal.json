    {
     "seite": "zimmer.html",
     "jedes": "#arten .preise > div",
     "felder": [
      {
       "key": "name",
       "label": "Bezeichnung",
       "art": "text",
       "wo": "span",
       "titel": true
      },
      {
       "key": "preis",
       "label": "Preis",
       "art": "zahl",
       "wo": "em"
      }
     ]
    }
   ]
  },
  "packages": {
   "quellen": [
    {
     "seite": "zimmer.html",
     "jedes": "#package .blatt",
     "felder": [
      {
       "key": "name",
       "label": "Name",
       "art": "text",
       "wo": "h3",
       "titel": true
      },
      {
       "key": "zusatz",
       "label": "Zeile darunter",
       "art": "text",
       "wo": ".blatt__kopf small"
      },
      {
       "key": "zeilen",
       "label": "Zeilen und Preise",
       "art": "liste",
       "wo": ".gang"
      }
     ]
    }
   ]
  },
  "saele": {
   "an": false
  },
  "unterlagen": {
   "quellen": [
    {
     "seite": "essen.html",
     "jedes": "a[href$=\".pdf\"]",
     "felder": [
      {
       "key": "name",
       "label": "Beschriftung",
       "art": "text",
       "wo": "",
       "titel": true
      },
      {
       "key": "link",
       "label": "Adresse",
       "art": "link",
       "wo": ""
